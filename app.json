{
  "expo": {
    "name": "Blossom like a Flower",
    "slug": "blossom-like-a-flower",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Blossom like a Flower to access your camera to identify flowers and reveal their spiritual significance.",
          "microphonePermission": "Allow Blossom like a Flower to access your microphone."
        }
      ],
      "expo-asset"
    ],
    "ios": {
      "bundleIdentifier": "com.workspace.blossomlikeaflower",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.workspace.blossomlikeaflower"
    },
    "extra": {
      "eas": {
        "projectId": "aed579cc-f62f-416c-a12a-2f3e1cf5a178"
      }
    }
  }
}

{
  "name": "blossom-like-a-flower",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --go",
    "start:dev": "expo start --dev-client",
    "start:tunnel": "expo start --go --tunnel",
    "start:clear": "expo start --go -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "deploy:web": "expo export -p web && firebase deploy --only hosting"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@react-native-async-storage/async-storage": "1.23.1",
    "expo": "~52.0.30",
    "expo-asset": "~11.0.5",
    "expo-camera": "~16.0.18",
    "expo-image": "~2.0.7",
    "expo-image-manipulator": "~13.0.6",
    "expo-system-ui": "~4.0.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.3.12",
    "typescript": "^5.3.3"
  }
}
